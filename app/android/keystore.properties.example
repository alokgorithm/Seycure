# Copy to keystore.properties in this directory and fill in the real values.
# keystore.properties is gitignored; this example is not.
# Keep an offline backup of both that file and seycure.keystore; losing the
# keystore means you can no longer ship updates under the same app listing.
storeFile=seycure.keystore
storePassword=
keyAlias=seycure
keyPassword=
