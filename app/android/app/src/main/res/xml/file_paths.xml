<?xml version="1.0" encoding="utf-8"?>
<!--
  Only app-private locations. Sharing a file from here needs no storage
  permission: the FileProvider URI handed to the share sheet is the grant.
  The old <external-path> entry pointed at shared external storage, which
  required WRITE_EXTERNAL_STORAGE and stopped working under scoped storage.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="." />
    <files-path name="my_files" path="." />
    <external-cache-path name="my_external_cache" path="." />
    <external-files-path name="my_external_files" path="." />
</paths>
